{
  "name": "destinos-do-brasil",
  "version": "1.0.0",
  "description": "Frontend de turismo para o trabalho de DevOps (pipeline DevSecOps com SonarQube, Trivy e kind)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve src -l 8080",
    "test": "node --test tests/*.test.js",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=src/filtros.js --test-coverage-include=src/destinos.js --test-coverage-include=src/fotos.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  }
}
